{
  "name": "knithelper",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "format": "biome format --write .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dep:cruise": "depcruise packages --config .dependency-cruiser.cjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm dep:cruise && pnpm test",
    "dev:api": "pnpm --filter @socky/api dev",
    "dev:web": "pnpm --filter @socky/web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "dependency-cruiser": "^18.6.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
